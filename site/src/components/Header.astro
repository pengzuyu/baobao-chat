---
import { APP_NAME } from '../data/brand';
import { GITHUB_URL, NAV, NAV_EN } from '../data/site';

interface Props {
  lang?: string;
}

const { lang = 'zh-CN' } = Astro.props;
const isEn = lang.startsWith('en');
const items = isEn ? NAV_EN : NAV;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const homeHref = isEn ? '/en/' : '/';
const switchHref = isEn ? '/' : '/en/';
const switchLabel = isEn ? '中文' : 'EN';
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href={homeHref}>
      <img src="/logo.svg" alt={`${APP_NAME} logo`} width="26" height="26" />
      <span>{APP_NAME}</span>
    </a>
    <nav class="nav" aria-label={isEn ? 'Main' : '主导航'}>
      {items.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <div class="header-actions">
      <a href={switchHref} hreflang={isEn ? 'zh-CN' : 'en'} title={switchLabel}>{switchLabel}</a>
      <a class="btn" href={GITHUB_URL} target="_blank" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
        </svg>
        <span class="gh-label">GitHub</span>
      </a>
    </div>
  </div>
</header>